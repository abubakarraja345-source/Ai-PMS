# ==========================
# Frontend
# ==========================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Base URL of the backend API (see frontend/lib/api.ts). Falls back to
# http://localhost:5000 in code if unset, so this can be left blank for
# local development.
# Local development: http://localhost:5000 (or leave blank)
# Production (Vercel): set to the deployed backend's URL once it exists
# (backend is still local-only as of this writing; do not fabricate one).
NEXT_PUBLIC_API_URL=

# ==========================
# Backend
# ==========================

PORT=5000
NODE_ENV=development

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

GEMINI_API_KEY=

RESEND_API_KEY=

REDIS_URL=

# Used for (1) CORS origin restriction in production only (see
# backend/src/app.ts — ignored in development so local dev against
# varying ports/hosts isn't broken), and (2) building the link inside
# team invitation emails (see
# backend/src/modules/organization/invitations.service.ts).
# Local development: http://localhost:3000
# Production: https://ai-pms-nu.vercel.app
FRONTEND_URL=http://localhost:3000

# Optional — how many days a team invitation stays valid before it's
# treated as expired. Defaults to 7 in code if unset.
# INVITATION_EXPIRY_DAYS=7