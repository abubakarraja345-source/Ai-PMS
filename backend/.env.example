# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# Frontend origin — used to build links (e.g. invitation accept URLs)
# and for CORS. No trailing slash.
FRONTEND_URL=http://localhost:3000

# Supabase (service-role only — this backend never uses the anon key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth
JWT_SECRET=

# Optional
REDIS_URL=
GEMINI_API_KEY=

# Invitations
# Days before a pending invitation expires. Defaults to 7 if unset.
INVITATION_EXPIRY_DAYS=7

# Brevo transactional email (invitation emails only). Both
# BREVO_API_KEY and BREVO_SENDER_EMAIL are required for emails to
# actually send — without them the app degrades gracefully (invitations
# still work, the email is just skipped). BREVO_SENDER_NAME is optional
# and defaults to "Hostly".
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Hostly

# iCal sync scheduler interval, in minutes. Defaults if unset — see
# modules/integrations/syncConfig.ts.
ICAL_SYNC_INTERVAL_MINUTES=

# Airbnb Official API (Phase 6A/6B) — all optional. Unset means the
# Airbnb API integration fails closed ("not configured") while iCal
# sync remains fully available. Never invent these; they only come
# from an approved Airbnb partner/developer application.
AIRBNB_CLIENT_ID=
AIRBNB_CLIENT_SECRET=
AIRBNB_REDIRECT_URI=
AIRBNB_AUTHORIZATION_URL=
AIRBNB_TOKEN_URL=
AIRBNB_API_BASE_URL=
# Development/testing only — never set true in production.
AIRBNB_USE_MOCK_ADAPTER=

# WhatsApp Business Cloud API (Meta Graph API) — guest messaging.
# Optional; unset means the messaging module fails closed. Get these
# from developers.facebook.com under a WhatsApp Business app.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# One WhatsApp number is supported per backend deployment today —
# see config/env.ts's own comment for why. The organization it's
# associated with.
WHATSAPP_ORGANIZATION_ID=
# Development/testing only — never set true in production.
WHATSAPP_USE_MOCK_ADAPTER=
